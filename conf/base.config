process {
  shell = ['/bin/bash', '-euo', 'pipefail']
  // With a scratch directory, the work directory is already on it; otherwise
  // each task runs in node-local scratch.
  scratch = params.scratch ? false : true
  errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
  maxRetries = 2
  maxErrors = '-1'

  withLabel: low {
    cpus = 1
    memory = { 2.GB * task.attempt }
    time = { 2.h * task.attempt }
    disk = 5.GB
  }
  withLabel: medium {
    cpus = 4
    memory = { 12.GB * task.attempt }
    time = { 12.h * task.attempt }
    disk = 50.GB
  }
  withLabel: statistics_high {
    cpus = { params.statistics_cpus as int }
    memory = { 32.GB * task.attempt }
    time = { 12.h * task.attempt }
    disk = 200.GB
  }
  withLabel: statistics_bootstrap {
    cpus = { params.statistics_bootstrap_cpus as int }
    memory = { 16.GB * task.attempt }
    time = { 6.h * task.attempt }
    disk = 100.GB
  }
  withLabel: serial_medium {
    cpus = 1
    memory = { 12.GB * task.attempt }
    time = { 12.h * task.attempt }
    disk = 50.GB
  }
  withLabel: serial_high {
    cpus = 1
    memory = { 32.GB * task.attempt }
    time = { 24.h * task.attempt }
    disk = 200.GB
  }
}
