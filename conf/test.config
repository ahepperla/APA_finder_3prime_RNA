params {
  input = "${projectDir}/tests/fixtures/samples.tsv"
  outdir = 'results-test'
  assembly = 'synthetic'
  fasta = "${projectDir}/tests/fixtures/genome.fa"
  gtf = "${projectDir}/tests/fixtures/genes.gtf"
  library_profile = 'exact_boundary'
  endpoint_model = 'exact_boundary'
  evidence_source = 'read_3p'
  // Statistics use the pipeline defaults. Only settings that a 36-gene
  // fixture cannot meet are relaxed here.
  calibration_min_genes = 20
  motif_preference_min_genes = 20
  strand_min_informative_fragments = 500
  strand_max_sampled_fragments = 1000
  dm_bootstrap_replicates = 50
  // Two genes per batch exercises the scattered bootstrap.
  statistics_bootstrap_batch_size = 2
  random_seed = 1800
}

// Small enough for a laptop or a CI runner.
process {
  withLabel: '.*' {
    cpus = 1
    memory = 2.GB
    time = 30.m
    disk = 5.GB
  }
}
