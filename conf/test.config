params {
  input = "${projectDir}/tests/fixtures/samples.tsv"
  outdir = 'results-test'
  assembly = 'synthetic'
  fasta = "${projectDir}/tests/fixtures/genome.fa"
  gtf = "${projectDir}/tests/fixtures/genes.gtf"
  library_profile = 'exact_boundary'
  endpoint_model = 'exact_boundary'
  evidence_source = 'read_3p'
  min_replicates_per_condition = 2
  pac_min_total_count = 2
  pac_min_sample_count = 1
  pac_min_supporting_samples = 2
  min_gene_total = 2
  min_site_count = 1
  min_test_supporting_samples = 1
  motif_preference_min_genes = 1
  calibration_min_genes = 1
  strand_min_informative_fragments = 1
  strand_max_sampled_fragments = 1000
  dm_bootstrap_replicates = 20
  random_seed = 1800
}

process {
  cpus = 1
  memory = 2.GB
  time = 30.m

  withLabel: low {
    cpus = 1
    memory = 2.GB
    time = 30.m
    disk = 5.GB
  }
  withLabel: medium {
    cpus = 1
    memory = 2.GB
    time = 30.m
    disk = 5.GB
  }
  withLabel: high {
    cpus = 1
    memory = 2.GB
    time = 30.m
    disk = 5.GB
  }
  withLabel: serial_medium {
    cpus = 1
    memory = 2.GB
    time = 30.m
    disk = 5.GB
  }
  withLabel: serial_high {
    cpus = 1
    memory = 2.GB
    time = 30.m
    disk = 5.GB
  }
}
