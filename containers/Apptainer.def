Bootstrap: docker
From: condaforge/miniforge3:24.11.3-0

%files
    envs/pacusage.yml /opt/pacusage/environment.yml
    pyproject.toml /opt/pacusage/pyproject.toml
    README.md /opt/pacusage/README.md
    LICENSE /opt/pacusage/LICENSE
    src /opt/pacusage/src

%post
    /opt/conda/bin/conda env create -n pacusage -f /opt/pacusage/environment.yml
    /opt/conda/envs/pacusage/bin/pip install \
        --no-deps --no-build-isolation /opt/pacusage
    /opt/conda/bin/conda clean --all --yes

%environment
    export PATH=/opt/conda/envs/pacusage/bin:$PATH
    export LC_ALL=C

%runscript
    exec "$@"
